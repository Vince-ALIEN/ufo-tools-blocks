{
  "$schema": "https://schemas.wp.org/trunk/block.json",
  "apiVersion": 3,
  "name": "ufo-blocks/ufo-grid",
  "version": "1.0.0",
  "title": "ufo Grid",
  "category": "ufo-blocks",
  "icon": "LayoutDashboard",
  "description": "Grille de 1 à 6 colonnes (une seule sur mobile) : sections de services, cartes, mosaïques. Chaque cellule est un ufo Row. Réglages : espacement, alignement vertical, largeur contenue, image ou vidéo de fond.",
  "allowedBlocks": ["ufo-blocks/ufo-row", "core/image"],
  "keywords": ["grid", "layout", "columns", "tailwind", "ufo"],
  "textdomain": "ufo-tools-blocks",
  "attributes": {
    "columnsCount": {
      "type": "number",
      "default": 2
    },
    "rowsCount": {
      "type": "number",
      "default": 0
    },
    "gap": {
      "type": "string",
      "default": "4",
      "enum": ["0", "1", "2", "3", "4", "5", "6", "7", "8"]
    },
    "verticalAlignment": {
      "type": "string"
    },
    "reverseMobile": {
      "type": "boolean",
      "default": false
    },
    "equalRows": {
      "type": "boolean",
      "default": true
    },
    "minHeight": {
      "type": "string",
      "default": ""
    },
    "borderRadius": {
      "type": "string",
      "default": ""
    },
    "isBoxed": {
      "type": "boolean",
      "default": false
    },
    "backgroundImage": {
      "type": "object",
      "default": {
        "url": "",
        "id": null,
        "alt": ""
      }
    },
    "backgroundSize": {
      "type": "string",
      "default": "cover"
    },
    "backgroundPosition": {
      "type": "string",
      "default": "center center"
    },
    "backgroundVideo": {
      "type": "object",
      "default": {
        "url": "",
        "id": null
      }
    },
    "paddingX": {
      "type": "string",
      "default": "0",
      "enum": ["0", "2", "4", "6", "8", "10", "12", "14", "16"]
    },
    "paddingY": {
      "type": "string",
      "default": "0",
      "enum": ["0", "2", "4", "6", "8", "10", "12", "14", "16"]
    }
  },
  "example": {
    "attributes": {
      "columnsCount": 3,
      "gap": "6"
    },
    "innerBlocks": [
      {
        "name": "ufo-blocks/ufo-row",
        "innerBlocks": [
          {
            "name": "ufo-blocks/ufo-title",
            "attributes": {
              "content": "Création de site",
              "level": 3,
              "icon": "Code"
            }
          },
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Des sites WordPress rapides et accessibles."
            }
          }
        ]
      },
      {
        "name": "ufo-blocks/ufo-row",
        "innerBlocks": [
          {
            "name": "ufo-blocks/ufo-title",
            "attributes": {
              "content": "Référencement",
              "level": 3,
              "icon": "Search"
            }
          },
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Être trouvé sur les moteurs de recherche."
            }
          }
        ]
      },
      {
        "name": "ufo-blocks/ufo-row",
        "innerBlocks": [
          {
            "name": "ufo-blocks/ufo-title",
            "attributes": {
              "content": "Maintenance",
              "level": 3,
              "icon": "ShieldCheck"
            }
          },
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Mises à jour et sauvegardes suivies."
            }
          }
        ]
      }
    ]
  },
  "providesContext": {
    "ufo-blocks/columnsCount": "columnsCount"
  },
  "supports": {
    "align": ["wide", "full"],
    "html": false,
    "color": {
      "gradients": true,
      "background": true,
      "text": true
    },
    "spacing": {
      "margin": true,
      "padding": true,
      "blockGap": true
    },
    "__experimentalBorder": {
      "color": true,
      "radius": true,
      "style": true,
      "width": true
    },
    "anchor": true
  },
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "style": "file:./style-index.css",
  "render": "file:./render.php"
}
