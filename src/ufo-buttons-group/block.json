{
  "apiVersion": 3,
  "name": "ufo-blocks/ufo-buttons-group",
  "title": "ufo Buttons",
  "category": "ufo-blocks",
  "icon": "StretchHorizontal",
  "description": "Rangée de ufo Button alignés à gauche, au centre ou à droite (en colonne sur mobile). Pour les appels à l'action en bas de section.",
  "supports": {
    "html": false,
    "anchor": true
  },
  "textdomain": "ufo-tools-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "attributes": {
    "buttonAlignment": {
      "type": "string",
      "default": "left"
    }
  },
  "example": {
    "attributes": {
      "buttonAlignment": "left"
    },
    "innerBlocks": [
      {
        "name": "ufo-blocks/ufo-button",
        "attributes": {
          "buttonText": "Demander un devis",
          "buttonUrl": "https://example.com/contact",
          "buttonIcon": "ArrowRight"
        }
      },
      {
        "name": "ufo-blocks/ufo-button",
        "attributes": {
          "buttonText": "Nos réalisations",
          "buttonUrl": "https://example.com/realisations"
        }
      }
    ]
  },
  "render": "file:./render.php"
}
