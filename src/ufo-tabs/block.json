{
  "apiVersion": 3,
  "name": "ufo-blocks/ufo-tabs",
  "title": "Ufo Tabs",
  "category": "ufo-blocks",
  "icon": "AppWindowMac",
  "description": "Onglets soulignés, accessibles au clavier : un ufo Tab par onglet (titre + contenu). Le premier onglet est ouvert. Pour présenter des offres ou des contenus alternatifs sans allonger la page.",
  "keywords": ["onglets", "tabs"],
  "supports": {
    "html": false,
    "anchor": true,
    "align": ["wide", "full"]
  },
  "textdomain": "ufo-tools-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "viewScript": "file:./view.js",
  "render": "file:./render.php",
  "example": {
    "innerBlocks": [
      {
        "name": "ufo-blocks/ufo-tab",
        "attributes": {
          "title": "Site vitrine"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Cinq à dix pages pour présenter votre activité."
            }
          }
        ]
      },
      {
        "name": "ufo-blocks/ufo-tab",
        "attributes": {
          "title": "Boutique"
        },
        "innerBlocks": [
          {
            "name": "core/paragraph",
            "attributes": {
              "content": "Vente en ligne avec WooCommerce."
            }
          }
        ]
      }
    ]
  }
}
