{
  "apiVersion": 3,
  "name": "ufo-blocks/ufo-button",
  "title": "UFO Button",
  "category": "ufo-blocks",
  "icon": "RectangleHorizontal",
  "description": "Bouton lien (balise <a>) avec icône Lucide facultative, à gauche ou à droite du texte. Sans URL, il n'a pas de href. Se place seul ou dans un ufo Buttons pour aligner plusieurs boutons.",
  "supports": {
    "html": false,
    "anchor": true,
    "color": {
      "text": true,
      "background": true,
      "link": false,
      "gradients": false
    },
    "border": {
      "radius": true,
      "width": true,
      "style": true,
      "color": true
    }
  },
  "textdomain": "ufo-tools-blocks",
  "editorScript": "file:./index.js",
  "editorStyle": "file:./index.css",
  "render": "file:./render.php",
  "attributes": {
    "buttonText": {
      "type": "string",
      "default": "Click me"
    },
    "buttonUrl": {
      "type": "string",
      "default": ""
    },
    "buttonIcon": {
      "type": "string",
      "default": ""
    },
    "opensInNewTab": {
      "type": "boolean",
      "default": false
    },
    "relNofollow": {
      "type": "boolean",
      "default": false
    },
    "iconPosition": {
      "type": "string",
      "default": "right"
    },
    "isFullWidth": {
      "type": "boolean",
      "default": false
    },
    "screenReaderText": {
      "type": "string",
      "default": ""
    }
  },
  "example": {
    "attributes": {
      "buttonText": "Demander un devis",
      "buttonUrl": "https://example.com/contact",
      "buttonIcon": "ArrowRight",
      "iconPosition": "right"
    }
  }
}
